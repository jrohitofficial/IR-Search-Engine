# Copy this file to ".env" in the IR_COURSEWORK root and fill in real values.
# Never commit the real ".env" file (it is already listed in .gitignore).

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DATABASE_NAME=ir_coursework

# --- Task 1: Vertical Search Engine ---
SEED_URL=https://pureportal.coventry.ac.uk/en/organisations/centre-for-healthcare-and-community-transformation/
CRAWLER_USER_AGENT=IRCourseworkBot/1.0 (Coventry ST7071CEM coursework crawler; contact: your-email@example.com)
CRAWL_DELAY_SECONDS=5
MAX_PROFILES=200
MAX_PUBLICATIONS=200
MAX_CRAWL_SECONDS=1800
CRAWL_INTERVAL_MONTHS=3
TOP_K=10
TASK1_PORT=5001

# --- Task 2: Document Clustering ---
MIN_DOCS_PER_CATEGORY=150
TARGET_DOCS_PER_CATEGORY=180
TASK2_PORT=5002
